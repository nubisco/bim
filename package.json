{
  "name": "@nubisco/bim",
  "version": "0.0.0",
  "description": "A building as a model: storeys, walls, spaces, doors and windows in millimetres, with validation, plan geometry, and an IFC4 writer and reader. Pure TypeScript, for the browser and Node alike.",
  "license": "MIT",
  "author": "José Silva <jose@nubisco.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nubisco/bim.git"
  },
  "homepage": "https://github.com/nubisco/bim#readme",
  "bugs": "https://github.com/nubisco/bim/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "quality:check": "pnpm run test && pnpm run types:check && pnpm run lint && pnpm run format:check && pnpm run build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "bim",
    "ifc",
    "ifc4",
    "floor-plan",
    "building",
    "architecture",
    "typescript",
    "nubisco"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm exec prettier --check . && pnpm run test",
    "pre-push": "pnpm run quality:check"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]"
        }
      ]
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
